@startuml workflow_layer
title NLI Engine — Workflow Layer

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "engine/workflow" {

    class WorkflowConfig <<Pydantic>> {
        + models: dict[str, str]
        + parameters: dict[str, Any]
        --
        + from_yaml(path): WorkflowConfig
    }

    class Message <<Pydantic>> {
        + role: Literal["user", "assistant", "tool"]
        + content: str | list | None
        + tool_calls: list[dict] | None
        + tool_call_id: str | None
    }

    abstract class WorkflowContext <<Pydantic, abstract>> {
        + history: list[Message]
    }

    class StepLog <<Pydantic, frozen>> {
        + step_name: str
        + model: str | None
        + input_tokens: int
        + output_tokens: int
        + latency_ms: float
        + extra: dict[str, Any]
    }

    class TurnResult <<Pydantic, frozen>> {
        + message: str
        + logs: list[StepLog]
        + done: bool
        + protocol: dict | None
    }

    abstract class Step {
        + name: str
        + tool_names: list[str]
        --
        + {abstract} run(context, tools): (Any, StepLog)
    }

    abstract class "Workflow<C: WorkflowContext>" as Workflow {
        + config: WorkflowConfig
        - _all_tools: dict[str, BoundTool]
        --
        + __init__(config, session)
        + {abstract} run_turn(user_input, context: C): TurnResult
        # _resolve_tools(step): list[BoundTool]
    }

    class WorkflowSpec <<dataclass, frozen>> {
        + id: str
        + name: str
        + description: str
        + workflow_class: type[Workflow]
        + context_class: type[WorkflowContext]
    }

    object "WORKFLOW_REGISTRY\ndict[str, WorkflowSpec]" as REGISTRY

    package "steps/" {
        class LLMStep {
            + name: str
            + tool_names: list[str]
            - _client: LLMClient
            - _system_prompt: str
            - _max_iterations: int
            --
            + run(context, tools): (str, StepLog)
        }

        note bottom of LLMStep
          Agentic loop: calls LLMClient.complete(),
          dispatches tool calls, repeats until
          the LLM produces a text response.
          Non-LLM steps subclass Step directly —
          no intermediate base.
        end note
    }

    package "workflows/" {
        class DummyWorkflow {
            + run_turn(user_input, context): TurnResult
        }

        class DummyLLMWorkflow {
            + run_turn(user_input, context): TurnResult
        }
    }
}

package "engine" {
    class Conversation {
        - _workflow: Workflow
        - _context: WorkflowContext
        --
        + __init__(spec, config, session)
        + turn(user_input): TurnResult
    }
}

package "engine (session layer)" {
    class ProtocolSession
    class BoundTool <<dataclass>>
}

WorkflowContext *-- Message
TurnResult *-- StepLog
Workflow *-- WorkflowConfig
Workflow ..> ProtocolSession : owns
Workflow ..> BoundTool : resolves from session
Workflow ..> Step : orchestrates
Workflow ..> TurnResult : produces
Step ..> StepLog : produces

REGISTRY o-- WorkflowSpec
WorkflowSpec ..> Workflow : workflow_class
WorkflowSpec ..> WorkflowContext : context_class

Conversation ..> WorkflowSpec : constructed from
Conversation ..> TurnResult : returns

LLMStep --|> Step
DummyWorkflow --|> Workflow
DummyLLMWorkflow --|> Workflow

note right of WorkflowContext
  Abstract. Every concrete workflow
  defines its own subclass and adds
  the fields its steps need.
end note

note right of Workflow
  Generic over C (bound to WorkflowContext).
  run_turn signature is typed to C so
  subclasses never need to cast.
  _resolve_tools filters _all_tools
  by step.tool_names before calling
  step.run(). Empty list = no tools.
end note

note right of TurnResult
  done=True → caller must not call
  run_turn() again. The workflow
  decides when it is finished.
end note

note right of Conversation
  GUI-agnostic driver shared by CLI
  and GUI. Holds the workflow instance
  and its context across turns.
end note

@enduml
